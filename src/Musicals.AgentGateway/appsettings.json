{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "ReverseProxy": {
    "Routes": {
      "anthropic": {
        "ClusterId": "anthropic",
        "Match": { "Path": "/{**catch-all}" },
        "Transforms": [ { "X-Forwarded": "Off" } ]
      }
    },
    "Clusters": {
      "anthropic": {
        "Destinations": {
          "api": { "Address": "https://api.anthropic.com" }
        },
        "HttpRequest": { "ActivityTimeout": "00:10:00" }
      }
    }
  }
}
